<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= titulo %></title>
  <link rel="icon" href="/img/Fevicon.png" type="image/png">
  <link rel="stylesheet" href="/css/estilos.css?v=<%= v %>">
  <script src="/js/app.js?v=<%= v %>" defer></script>
  <% (typeof scripts !== 'undefined' ? scripts : []).forEach(function (s) { %>
  <script src="/js/<%= s %>.js?v=<%= v %>" defer></script>
  <% }) %>
</head>
<body>
<header class="barra">
  <div class="contenedor barra__fila">
    <a class="marca" href="/">
      <img src="/img/logo.png" alt="" width="36" height="36">
      <span>Carta Digital</span>
    </a>

    <% if (usuario) { %>
      <nav class="menu" aria-label="Tu cuenta">
        <span class="sesion__hola">Hola, <strong><%= usuario.nombre %></strong></span>
        <a class="menu__link <%= rutaActual === '/mis-pedidos' ? 'menu__link--activo' : '' %>" href="/mis-pedidos">Mis pedidos</a>
        <a class="menu__link <%= rutaActual === '/cuenta' ? 'menu__link--activo' : '' %>" href="/cuenta">Mi cuenta</a>
        <% if (usuario.rol === 'admin') { %>
          <a class="menu__link menu__link--admin <%= rutaActual === '/admin' ? 'menu__link--activo' : '' %>" href="/admin">Admin</a>
        <% } %>
        <form class="sesion" action="/logout" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="volver" value="/">
          <button type="submit" class="btn btn--fantasma btn--chico">Cerrar sesión</button>
        </form>
      </nav>
    <% } else { %>
      <details class="login">
        <summary class="btn btn--fantasma">Iniciar sesión</summary>
        <form class="login__form" action="/login" method="post" autocomplete="on">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="volver" value="<%= rutaActual %>">
          <label>Correo
            <input type="email" name="email" required maxlength="255" autocomplete="username">
          </label>
          <label>Contraseña
            <input type="password" name="password" required maxlength="128" autocomplete="current-password">
          </label>
          <button type="submit" class="btn">Ingresar</button>
          <p class="login__links">
            <a href="/recuperar">¿Olvidaste tu contraseña?</a>
            <a href="/registro">Crear una cuenta</a>
          </p>
        </form>
      </details>
    <% } %>
  </div>
</header>

<% if (aviso) { %>
  <div class="aviso aviso--<%= aviso.tipo === 'ok' ? 'ok' : 'error' %>" role="status">
    <div class="contenedor"><%= aviso.texto %></div>
  </div>
<% } %>

<main>
