<%- include('partials/head') %>

<section class="portada">
  <div class="contenedor">
    <h1>Elige tu restaurante</h1>
    <p>Revisa la carta, arma tu pedido y deja tu comentario.</p>
    <form class="formulario formulario--fila seguir" action="/seguimiento" method="get" role="search">
      <label>¿Ya hiciste un pedido? Síguelo con tu código
        <input type="text" name="codigo" required maxlength="8" pattern="[A-Za-z2-9]{8}" placeholder="K7P2QX9M" class="input-codigo" spellcheck="false">
      </label>
      <button type="submit" class="btn btn--fantasma">Ver pedido</button>
    </form>
  </div>
</section>

<section class="contenedor">
  <% if (restaurantes.length === 0) { %>
    <p class="vacio">Aún no hay restaurantes publicados.</p>
  <% } else { %>
    <ul class="grilla-restaurantes">
      <% restaurantes.forEach(function (r) { %>
        <li>
          <a class="tarjeta-resto" href="/restaurantes/<%= r.id %>">
            <img src="<%= imagenRestaurante(r.id, r.foto) %>" alt="" width="72" height="72" loading="lazy">
            <span>
              <strong><%= r.nombre %></strong>
              <small><%= r.comuna %></small>
            </span>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<%- include('partials/footer') %>
