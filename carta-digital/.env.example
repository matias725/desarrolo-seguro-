# Copia este archivo como .env y completa los valores.
# El archivo .env NO se sube a Git (está en .gitignore).

# development | qa | production
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carta_digital
DB_USER=carta_app
DB_PASSWORD=cambia_esta_clave
# true si la BD exige SSL (por ejemplo Amazon RDS)
DB_SSL=false

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres en producción).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio

# Número de proxies delante de la app (Nginx/Cloudflare/ALB). En producción por defecto 1.
# TRUST_PROXY=1

# Logs: fatal | error | warn | info | debug | silent (por defecto info en producción)
# LOG_LEVEL=info

# Documentación interactiva de la API en /api/docs (Swagger).
# Por defecto activa en desarrollo/QA y desactivada en producción.
# API_DOCS=true

# ---- Seguridad de cuentas
# URL pública de la app (se usa en los correos; nunca se toma de la cabecera Host).
# APP_URL=https://carta.midominio.cl
# Clave para cifrar los secretos 2FA en la BD (recomendado en producción, 32+ caracteres).
# Si no se define, se deriva de SESSION_SECRET.
# CIFRADO_CLAVE=
# Bloqueo por cuenta (por defecto 5 fallos -> 15 minutos)
# BLOQUEO_MAX_FALLOS=5
# BLOQUEO_MINUTOS=15

# ---- Correo (recuperación de contraseña y alertas)
# consola (desarrollo: el correo sale en los logs) | ses (Amazon SES) | desactivado
# CORREO_PROVEEDOR=ses
# CORREO_REMITENTE=Carta Digital <no-responder@midominio.cl>
# AWS_REGION=us-east-1
# Correos extra que reciben las alertas graves (además de los admins), separados por coma
# CORREO_ALERTAS=seguridad@midominio.cl
