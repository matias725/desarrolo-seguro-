# Endurecimiento para entornos Apache con AllowOverride (XAMPP/WAMP).
# En AWS las mismas reglas se aplican desde la configuración del VirtualHost.
Options -Indexes
ServerSignature Off

# Archivos de configuración e internos: no accesibles desde la web.
<FilesMatch "^(config\.local\.php|config\.example\.php|setup\.php|\.ht.*|.*\.(sql|md|bak|ini|log))$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    # VUL034: PHP tambien envia estas cabeceras; se quita su copia y Apache
    # deja una sola (incluidas las respuestas de error).
    Header unset X-Content-Type-Options
    Header always set X-Content-Type-Options "nosniff"
    Header unset X-Frame-Options
    Header always set X-Frame-Options "DENY"
    Header unset Referrer-Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>
